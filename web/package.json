    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
